import { Palette, Type } from "theme.slint";

/// A frosted panel: translucent fill, hairline edge, 16 corner radius.
export component Card inherits Rectangle {
    background: Palette.glass;
    border-radius: 16px;
    border-width: 1px;
    border-color: Palette.glass-edge;
    clip: true;
}

/// A horizontal row that runs right to left in a right-to-left language (Persian). The software renderer cannot mirror a
/// whole window, so every row in the app is one of these. `alignment: stretch` lets an item with `horizontal-stretch: 1`
/// take the free space; `start` packs the items at the start edge. `pad-start` / `pad-end` are padding on the side where
/// the row begins and ends, whichever that is.
export component HRow inherits FlexboxLayout {
    in property <length> pad-start;
    in property <length> pad-end;
    flex-direction: Palette.rtl ? row-reverse : row;
    flex-wrap: no-wrap;
    cross-axis-alignment: center;
    padding-left: Palette.rtl ? pad-end : pad-start;
    padding-right: Palette.rtl ? pad-start : pad-end;
}

/// Text in the app's typography, aligned to the start of the line: left, or right in a right-to-left language.
export component Label inherits Text {
    in property <bool> muted: false;
    font-family: Type.family;
    font-size: Type.body-medium;
    color: muted ? Palette.on-variant : Palette.on-surface;
    vertical-alignment: center;
    horizontal-alignment: Palette.rtl ? right : left;
}

/// A small flat icon button (the Kotlin IconAction): icon, then an optional caption.
export component IconAction inherits Rectangle {
    in property <image> icon;
    in property <string> caption;
    in property <bool> enabled: true;
    in property <bool> filled: false;
    in property <brush> tint: Palette.primary;
    callback clicked();
    horizontal-stretch: 0;
    height: 36px;
    // an icon-only button is a 36 px square; with a caption it is as wide as its content
    width: caption == "" ? 36px : row.preferred-width + 20px;
    border-radius: 10px;
    background: filled ? (enabled ? Palette.primary : Palette.primary.with-alpha(0.35)) : (touch.has-hover && enabled ? Palette.primary.with-alpha(0.09) : transparent);
    row := HRow {
        pad-start: 10px; pad-end: 10px; spacing: 8px;
        Image { source: icon; colorize: filled ? Palette.on-primary : tint; width: 18px; height: 18px; opacity: enabled ? 1 : 0.38; }
        if caption != "" : Label { text: caption; color: filled ? Palette.on-primary : tint; font-size: Type.body-small; font-weight: 500; }
    }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

/// A text button. `primary` is the solid one (the main action of a dialog).
export component Button inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();
    horizontal-stretch: 0;
    height: 40px;
    width: label.preferred-width + 32px;
    border-radius: 12px;
    background: primary ? Palette.primary : (touch.has-hover && enabled ? Palette.primary.with-alpha(0.09) : transparent);
    opacity: enabled ? 1 : 0.45;
    label := Label {
        x: 16px; y: 0px; width: parent.width - 32px; height: parent.height; text: root.text;
        font-size: Type.body-medium; font-weight: 500;
        color: primary ? Palette.on-primary : Palette.primary;
        horizontal-alignment: center;
    }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: enabled ? pointer : default; clicked => { root.clicked(); } }
}

/// A text box with a placeholder; `multiline` makes it a taller box that wraps. Ctrl+V pastes into it as usual.
export component TextField inherits Rectangle {
    in property <string> placeholder;
    in property <bool> multiline: false;
    in property <bool> password: false;
    in-out property <string> text <=> input.text;
    callback accepted(string);      // Enter pressed
    public function paste() { input.focus(); input.paste(); }
    height: multiline ? 96px : 44px;
    border-radius: 12px;
    border-width: 1px;
    border-color: input.has-focus ? Palette.primary : Palette.outline-variant;
    background: Palette.dark ? #00000040 : #ffffffa0;
    input := TextInput {
        x: 12px; y: multiline ? 10px : 0px;
        width: parent.width - 24px; height: multiline ? parent.height - 20px : parent.height;
        single-line: !multiline;
        input-type: password ? InputType.password : InputType.text;
        wrap: multiline ? word-wrap : no-wrap;
        font-family: Type.family; font-size: Type.body-medium; color: Palette.on-surface;
        vertical-alignment: multiline ? top : center;
        selection-background-color: Palette.primary.with-alpha(0.4);
        accepted => { root.accepted(self.text); }
    }
    if input.text == "" : Text {
        x: 12px; y: multiline ? 10px : 0px; width: parent.width - 24px; height: multiline ? 24px : parent.height;
        text: placeholder; color: Palette.on-variant; font-family: Type.family; font-size: Type.body-medium;
        vertical-alignment: multiline ? top : center; overflow: elide;
    }
}

/// An on/off switch (the Material one in the Kotlin app).
export component ToggleSwitch inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    horizontal-stretch: 0;
    width: 48px; height: 28px; border-radius: 14px;
    border-width: 2px;
    border-color: checked ? Palette.primary : Palette.on-variant;
    background: checked ? Palette.primary : transparent;
    Rectangle {
        width: 18px; height: 18px; border-radius: 9px;
        x: checked ? 24px : 5px; y: 5px;
        background: checked ? Palette.on-primary : Palette.on-variant;
        animate x { duration: 150ms; easing: ease-out; }
    }
    TouchArea { enabled: root.enabled; mouse-cursor: enabled ? pointer : default; clicked => { root.toggled(!root.checked); } }
}
