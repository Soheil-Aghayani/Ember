// The window: backdrop, sidebar, the current page. Port of MainShell/Sidebar in desktop/.../ui/App.kt.
import { Palette, Type, Icons, Motion, Tr } from "theme.slint";
import { Label, HRow } from "widgets.slint";
import { HomePage, ServerRow } from "home.slint";
import { ServersPage, SubRow, NodeRow } from "servers.slint";
import { LogsPage } from "logs.slint";
import { SettingsPage } from "settings.slint";
import { AboutPage, WhatsNewPage, InfoItem, ReleaseRow } from "about.slint";
export { Palette, Motion, Tr, ServerRow, SubRow, NodeRow, InfoItem, ReleaseRow }

component NavItem inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> active;
    callback clicked();
    height: 42px;
    border-radius: 10px;
    background: active ? Palette.primary.with-alpha(0.16) : (touch.has-hover ? Palette.primary.with-alpha(0.09) : transparent);
    HRow {
        pad-start: 12px; spacing: 12px;
        Image { source: icon; colorize: active ? Palette.primary : Palette.on-surface; width: 20px; height: 20px; }
        Label { text: root.text; font-size: Type.title-small; font-weight: 500; color: active ? Palette.primary : Palette.on-surface; }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component App inherits Window {
    // page: 0 Home, 1 Servers, 2 Settings, 3 Logs, 4 What's new, 5 About
    in-out property <int> page: 0;
    in property <int> state;
    in property <string> status;
    in property <string> secondary;
    in property <string> server-title;
    in property <image> server-flag;
    in property <bool> server-has-flag;
    in property <string> server-detail;
    in property <bool> can-pick: true;
    in property <bool> auto-selected;
    in property <[ServerRow]> servers;
    in property <string> caption;
    in property <string> error;
    in property <int> menu-request;
    in property <bool> testing;
    in property <string> test-progress;
    callback orb-clicked();
    callback choose(string);
    callback test-speed();
    callback cancel-test();
    in property <[SubRow]> subs;
    in property <string> page-notice;
    in property <bool> page-notice-error;
    in property <bool> dialog-busy;
    in property <string> dialog-error;
    in property <int> dialog-done;
    in property <int> dialog-request;
    in property <[string]> log-lines;
    in property <bool> log-has-entries;
    in-out property <int> log-filter: 0;
    in property <string> set-language;
    in property <string> set-theme;
    in property <bool> set-auto-connect;
    in property <bool> set-auto-failover;
    in property <bool> set-diagnostic-log;
    in property <bool> set-keep-in-tray;
    in property <bool> set-start-with-windows;
    callback language-chosen(string);
    callback theme-chosen(string);
    callback flag-toggled(string, bool);
    in property <[InfoItem]> about-info;
    in property <[InfoItem]> about-licenses;
    in property <[ReleaseRow]> releases;
    callback open-contact();
    in property <string> toast;
    in property <bool> toast-error;
    callback log-filter-changed(int);
    callback copy-logs();
    callback clear-logs();
    callback copy-report();
    in property <string> pasted-text;
    in property <int> paste-serial;
    callback paste-request();
    callback toggle-expanded(string);
    callback favorite(string);
    callback test-subscription(string);
    callback refresh-subscription(string);
    callback remove-subscription(string);
    callback submit-subscription(string, string, string);

    title: "Ember";
    default-font-family: Type.family;
    min-width: 760px; min-height: 600px;
    preferred-width: 900px; preferred-height: 680px;
    background: Palette.background;

    Image {
        source: Palette.dark ? @image-url("assets/art/bg-dark.png") : @image-url("assets/art/bg-light.png");
        width: parent.width; height: parent.height; image-fit: cover;
    }
    if Palette.dark : Rectangle { background: #0000004d; }

    HRow {
        alignment: stretch; cross-axis-alignment: stretch;
        VerticalLayout {
            width: 220px; padding: 16px; spacing: 4px; alignment: start;
            HRow {
                pad-start: 8px; padding-bottom: 24px; spacing: 10px; height: 60px;
                Image { source: @image-url("assets/ember_logo_128.png"); width: 36px; height: 36px; }
                Label { text: "Ember"; font-size: Type.headline-small; font-weight: 600; }
            }
            NavItem { icon: Icons.home; text: Tr.home; active: page == 0; clicked => { page = 0; } }
            NavItem { icon: Icons.subscriptions; text: Tr.servers; active: page == 1; clicked => { page = 1; } }
            NavItem { icon: Icons.settings; text: Tr.settings; active: page == 2; clicked => { page = 2; } }
            NavItem { icon: Icons.logs; text: Tr.logs; active: page == 3; clicked => { page = 3; } }
            Rectangle { vertical-stretch: 1; }
            NavItem { icon: Icons.whats-new; text: Tr.whats-new; active: page == 4; clicked => { page = 4; } }
            NavItem { icon: Icons.info-circle; text: Tr.about; active: page == 5; clicked => { page = 5; } }
        }
        Rectangle { width: 1px; background: Palette.divider; }
        Rectangle {
            horizontal-stretch: 1;
            Rectangle {
                width: min(640px, parent.width);
                x: (parent.width - self.width) / 2;
                if page == 0 : HomePage {
                    x: 32px; y: 0; width: parent.width - 64px; height: parent.height;
                    state: root.state; status: root.status; secondary: root.secondary;
                    server-title: root.server-title; server-flag: root.server-flag; server-has-flag: root.server-has-flag;
                    server-detail: root.server-detail; can-pick: root.can-pick; auto-selected: root.auto-selected; servers: root.servers;
                    caption: root.caption; error: root.error; menu-request: root.menu-request; testing: root.testing; test-progress: root.test-progress;
                                orb-clicked => { root.orb-clicked(); }
                    choose(id) => { root.choose(id); }
                    open-servers => { root.page = 1; }
                    test-speed => { root.test-speed(); }
                    cancel-test => { root.cancel-test(); }
                }
                if page == 1 : ServersPage {
                    x: 32px; y: 0; width: parent.width - 64px; height: parent.height;
                    subs: root.subs; testing: root.testing; can-test: root.can-pick; test-progress: root.test-progress;
                    notice: root.page-notice; notice-error: root.page-notice-error;
                    dialog-busy: root.dialog-busy; dialog-error: root.dialog-error; dialog-done: root.dialog-done; dialog-request: root.dialog-request; pasted-text: root.pasted-text; paste-serial: root.paste-serial;
                    toggle-expanded(id) => { root.toggle-expanded(id); }
                    select(id) => { root.choose(id); }
                    favorite(id) => { root.favorite(id); }
                    test(id) => { root.test-subscription(id); }
                    stop-test => { root.cancel-test(); }
                    refresh(id) => { root.refresh-subscription(id); }
                    remove(id) => { root.remove-subscription(id); }
                    submit(id, link, name) => { root.submit-subscription(id, link, name); }
                    paste-request => { root.paste-request(); }
                }
                if page == 3 : LogsPage {
                    x: 32px; y: 0; width: parent.width - 64px; height: parent.height;
                    lines: root.log-lines; has-entries: root.log-has-entries; filter <=> root.log-filter;
                    filter-changed(f) => { root.log-filter-changed(f); }
                    copy => { root.copy-logs(); }
                    clear => { root.clear-logs(); }
                    copy-report => { root.copy-report(); }
                }
                if page == 2 : SettingsPage {
                    x: 32px; y: 0; width: parent.width - 64px; height: parent.height;
                    language: root.set-language; theme: root.set-theme; auto-connect: root.set-auto-connect;
                    auto-failover: root.set-auto-failover; diagnostic-log: root.set-diagnostic-log;
                    keep-in-tray: root.set-keep-in-tray; start-with-windows: root.set-start-with-windows;
                    language-chosen(v) => { root.language-chosen(v); }
                    theme-chosen(v) => { root.theme-chosen(v); }
                    flag-toggled(key, v) => { root.flag-toggled(key, v); }
                }
                if page == 4 : WhatsNewPage {
                    x: 32px; y: 0; width: parent.width - 64px; height: parent.height;
                    releases: root.releases;
                }
                if page == 5 : AboutPage {
                    x: 32px; y: 0; width: parent.width - 64px; height: parent.height;
                    info: root.about-info; licenses: root.about-licenses;
                    open-contact => { root.open-contact(); }
                }
            }
        }
    }

    if toast != "" : Rectangle {
        width: min(toast-row.preferred-width + 32px, parent.width - 32px); height: 44px;
        x: (parent.width - self.width) / 2; y: parent.height - self.height - 24px;
        border-radius: 14px; background: Palette.inverse-surface;
        toast-row := HRow {
            alignment: center; pad-start: 16px; pad-end: 16px; spacing: 10px;
            if toast-error : Image { source: Icons.warning; colorize: Palette.toast-bad; width: 20px; height: 20px; }
            if !toast-error : Image { source: Icons.check; colorize: Palette.toast-ok; width: 20px; height: 20px; }
            Label { text: root.toast; color: Palette.inverse-on; font-size: Type.body-medium; overflow: elide; }
        }
    }
}
