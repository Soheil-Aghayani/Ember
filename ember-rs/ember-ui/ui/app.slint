// The window: backdrop, sidebar, the current page. Port of MainShell/Sidebar in desktop/.../ui/App.kt.
import { Palette, Type, Icons, Motion, Tr } from "theme.slint";
import { Label, HRow, Button, TextField } from "widgets.slint";
import { HomePage, ServerRow } from "home.slint";
import { ServersPage, SubRow, NodeRow, SitePreset } from "servers.slint";
import { LogsPage } from "logs.slint";
import { SettingsPage, SettingsData } from "settings.slint";
import { AboutPage, WhatsNewPage, InfoItem, ReleaseRow } from "about.slint";
export { Palette, Motion, Tr, ServerRow, SubRow, NodeRow, SitePreset, InfoItem, ReleaseRow, SettingsData }

component NavItem inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> active;
    callback clicked();
    height: 42px;
    border-radius: 10px;
    background: active ? Palette.primary.with-alpha(0.16) : (touch.has-hover ? Palette.primary.with-alpha(0.09) : transparent);
    animate background { duration: 120ms; easing: ease-out; }
    HRow {
        pad-start: 12px; spacing: 12px;
        Image { source: icon; colorize: active ? Palette.primary : Palette.on-surface; width: 20px; height: 20px; }
        Label { text: root.text; font-size: Type.title-small; font-weight: 500; color: active ? Palette.primary : Palette.on-surface; }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component App inherits Window {
    // page: 0 Home, 1 Servers, 2 Settings, 3 Logs, 4 What's new, 5 About
    in-out property <int> page: 0;
    in property <int> state;
    in property <string> status;
    in property <string> secondary;
    in property <string> server-title;
    in property <image> server-flag;
    in property <bool> server-has-flag;
    in property <string> server-detail;
    in property <bool> can-pick: true;
    in property <bool> auto-selected;
    in property <[ServerRow]> servers;
    in property <string> caption;
    in property <string> error;
    in property <int> menu-request;
    in property <bool> testing;
    in property <string> test-progress;
    callback orb-clicked();
    callback choose(string);
    callback cancel-test();
    in property <[SubRow]> subs;
    in property <string> page-notice;
    in property <bool> page-notice-error;
    in property <bool> dialog-busy;
    in property <string> dialog-error;
    in property <int> dialog-done;
    in property <int> dialog-request;
    in property <[string]> log-lines;
    in property <bool> log-has-entries;
    in-out property <int> log-filter: 0;
    in property <SettingsData> settings-data;
    in property <string> list-error;
    in property <string> blocked-notice;
    in property <bool> can-restore: true;
    in property <bool> cred-open;
    in property <string> cred-title;
    in property <bool> cred-ask-user;
    property <string> cred-user;
    property <string> cred-pass;
    callback language-chosen(string);
    callback theme-chosen(string);
    callback flag-toggled(string, bool);
    callback app-mode-chosen(string);
    callback list-add(string, string);
    callback list-remove(string, int);
    callback trust-network();
    callback mtu-apply(string);
    callback backup-save();
    callback backup-restore();
    callback restore-confirm();
    callback restore-cancel();
    in property <string> backup-message;
    in property <bool> restore-open;
    in property <string> restore-text;
    callback restore-internet();
    callback cred-submit(string, string);
    callback cred-cancel();
    changed cred-open => { if cred-open { cred-user = ""; cred-pass = ""; } }
    in property <[InfoItem]> about-info;
    in property <[InfoItem]> about-licenses;
    in property <[ReleaseRow]> releases;
    callback open-contact();
    in property <string> toast;
    in property <bool> toast-error;
    callback log-filter-changed(int);
    callback copy-logs();
    callback clear-logs();
    callback copy-report();
    in property <string> pasted-text;
    in property <int> paste-serial;
    callback paste-request();
    callback toggle-expanded(string);
    callback favorite(string);
    callback test-subscription(string);
    callback ping-subscription(string);
    callback refresh-subscription(string);
    callback remove-subscription(string);
    callback submit-subscription(string, string, string);
    callback import-files();
    callback add-warp();
    callback show-qr(string);
    callback copy-link(string);
    callback check-site(string);
    callback clear-site-check();
    in property <[SitePreset]> site-presets;
    in property <string> site-label;
    in property <string> qr-title;
    in property <string> qr-link;
    in property <image> qr-image;
    in property <bool> qr-has-image;
    in-out property <bool> qr-open;

    title: "Ember";
    icon: @image-url("assets/ember_logo_128.png");
    no-frame: true;
    callback window-drag();
    callback window-resize(int);
    callback window-minimize();
    callback window-maximize();
    callback window-close();
    default-font-family: Type.family;
    min-width: 760px; min-height: 600px;
    preferred-width: 900px; preferred-height: 680px;
    background: Palette.background;

    Image {
        source: Palette.dark ? @image-url("assets/art/bg-dark.png") : @image-url("assets/art/bg-light.png");
        width: parent.width; height: parent.height; image-fit: cover;
    }
    if Palette.dark : Rectangle { background: #0000004d; }

    HRow {
        alignment: stretch; cross-axis-alignment: stretch;
        VerticalLayout {
            width: 220px; padding: 16px; spacing: 4px; alignment: start;
            HRow {
                pad-start: 8px; padding-bottom: 24px; spacing: 10px; height: 60px;
                Image { source: @image-url("assets/ember_logo_128.png"); width: 36px; height: 36px; }
                Label { text: "Ember"; font-size: Type.headline-small; font-weight: 600; }
            }
            NavItem { icon: Icons.home; text: Tr.home; active: page == 0; clicked => { page = 0; } }
            NavItem { icon: Icons.subscriptions; text: Tr.servers; active: page == 1; clicked => { page = 1; } }
            NavItem { icon: Icons.settings; text: Tr.settings; active: page == 2; clicked => { page = 2; } }
            NavItem { icon: Icons.logs; text: Tr.logs; active: page == 3; clicked => { page = 3; } }
            Rectangle { vertical-stretch: 1; }
            NavItem { icon: Icons.whats-new; text: Tr.whats-new; active: page == 4; clicked => { page = 4; } }
            NavItem { icon: Icons.info-circle; text: Tr.about; active: page == 5; clicked => { page = 5; } }
        }
        Rectangle { width: 1px; background: Palette.divider; }
        Rectangle {
            horizontal-stretch: 1;
            Rectangle {
                width: min(640px, parent.width);
                x: (parent.width - self.width) / 2;
                if page == 0 : HomePage {
                    x: 32px; y: (1 - Motion.page-in) * 14px; width: parent.width - 64px; height: parent.height; opacity: Motion.page-in;
                    state: root.state; status: root.status; secondary: root.secondary;
                    server-title: root.server-title; server-flag: root.server-flag; server-has-flag: root.server-has-flag;
                    server-detail: root.server-detail; can-pick: root.can-pick; auto-selected: root.auto-selected; servers: root.servers;
                    caption: root.caption; error: root.error; menu-request: root.menu-request;
                    blocked-notice: root.blocked-notice; can-restore: root.can-restore;
                    restore-internet => { root.restore-internet(); }
                                orb-clicked => { root.orb-clicked(); }
                    choose(id) => { root.choose(id); }
                    open-servers => { root.page = 1; }
                }
                if page == 1 : ServersPage {
                    x: 32px; y: 32px + (1 - Motion.page-in) * 14px; width: parent.width - 64px; height: parent.height - 32px; opacity: Motion.page-in;
                    subs: root.subs; testing: root.testing; can-test: root.can-pick; test-progress: root.test-progress;
                    notice: root.page-notice; notice-error: root.page-notice-error;
                    dialog-busy: root.dialog-busy; dialog-error: root.dialog-error; dialog-done: root.dialog-done; dialog-request: root.dialog-request; pasted-text: root.pasted-text; paste-serial: root.paste-serial;
                    site-presets: root.site-presets; site-label: root.site-label;
                    qr-title: root.qr-title; qr-link: root.qr-link; qr-image: root.qr-image; qr-has-image: root.qr-has-image; qr-open <=> root.qr-open;
                    import-files => { root.import-files(); }
                    add-warp => { root.add-warp(); }
                    show-qr(id) => { root.show-qr(id); }
                    copy-link(link) => { root.copy-link(link); }
                    check-site(input) => { root.check-site(input); }
                    clear-site-check => { root.clear-site-check(); }
                    toggle-expanded(id) => { root.toggle-expanded(id); }
                    select(id) => { root.choose(id); }
                    favorite(id) => { root.favorite(id); }
                    ping(id) => { root.ping-subscription(id); }
                    test(id) => { root.test-subscription(id); }
                    stop-test => { root.cancel-test(); }
                    refresh(id) => { root.refresh-subscription(id); }
                    remove(id) => { root.remove-subscription(id); }
                    submit(id, link, name) => { root.submit-subscription(id, link, name); }
                    paste-request => { root.paste-request(); }
                }
                if page == 3 : LogsPage {
                    x: 32px; y: 32px + (1 - Motion.page-in) * 14px; width: parent.width - 64px; height: parent.height - 32px; opacity: Motion.page-in;
                    lines: root.log-lines; has-entries: root.log-has-entries; filter <=> root.log-filter;
                    filter-changed(f) => { root.log-filter-changed(f); }
                    copy => { root.copy-logs(); }
                    clear => { root.clear-logs(); }
                    copy-report => { root.copy-report(); }
                }
                if page == 2 : SettingsPage {
                    x: 32px; y: 32px + (1 - Motion.page-in) * 14px; width: parent.width - 64px; height: parent.height - 32px; opacity: Motion.page-in;
                    d: root.settings-data; list-error: root.list-error;
                    app-mode-chosen(m) => { root.app-mode-chosen(m); }
                    list-add(kind, text) => { root.list-add(kind, text); }
                    list-remove(kind, i) => { root.list-remove(kind, i); }
                    trust-network => { root.trust-network(); }
                    backup-message: root.backup-message;
                    mtu-apply(v) => { root.mtu-apply(v); }
                    backup-save => { root.backup-save(); }
                    backup-restore => { root.backup-restore(); }
                    language-chosen(v) => { root.language-chosen(v); }
                    theme-chosen(v) => { root.theme-chosen(v); }
                    flag-toggled(key, v) => { root.flag-toggled(key, v); }
                }
                if page == 4 : WhatsNewPage {
                    x: 32px; y: 32px + (1 - Motion.page-in) * 14px; width: parent.width - 64px; height: parent.height - 32px; opacity: Motion.page-in;
                    releases: root.releases;
                }
                if page == 5 : AboutPage {
                    x: 32px; y: 32px + (1 - Motion.page-in) * 14px; width: parent.width - 64px; height: parent.height - 32px; opacity: Motion.page-in;
                    info: root.about-info; licenses: root.about-licenses;
                    open-contact => { root.open-contact(); }
                }
            }
        }
    }

    if restore-open : Rectangle {
        background: #00000088;
        TouchArea { }
        Rectangle {
            width: min(420px, parent.width - 32px); height: rest.preferred-height + 48px;
            x: (parent.width - self.width) / 2; y: max(24px, (parent.height - self.height) / 3);
            border-radius: 16px; border-width: 1px; border-color: Palette.glass-edge;
            background: Palette.dark ? #24201c : #ffffff;
            rest := VerticalLayout {
                padding: 24px; spacing: 12px;
                Label { text: Tr.restore-backup; font-size: Type.headline-small; font-weight: 600; wrap: word-wrap; }
                Label { text: root.restore-text; muted: true; wrap: word-wrap; }
                HRow {
                    alignment: end; height: 40px; spacing: 8px;
                    Button { text: Tr.cancel; clicked => { root.restore-cancel(); } }
                    Button { text: Tr.restore-and-restart; primary: true; clicked => { root.restore-confirm(); } }
                }
            }
        }
    }

    if cred-open : Rectangle {
        background: #00000088;
        TouchArea { }   // blocks the window behind the dialog
        Rectangle {
            width: min(420px, parent.width - 32px); height: cred.preferred-height + 48px;
            x: (parent.width - self.width) / 2; y: max(24px, (parent.height - self.height) / 3);
            border-radius: 16px; border-width: 1px; border-color: Palette.glass-edge;
            background: Palette.dark ? #24201c : #ffffff;
            cred := VerticalLayout {
                padding: 24px; spacing: 12px;
                Label { text: root.cred-title; font-size: Type.headline-small; font-weight: 600; wrap: word-wrap; }
                if cred-ask-user : Label { text: Tr.username; muted: true; font-size: Type.body-small; }
                if cred-ask-user : TextField { text <=> root.cred-user; }
                Label { text: Tr.password; muted: true; font-size: Type.body-small; }
                TextField { password: true; text <=> root.cred-pass; }
                Label { text: Tr.credentials-not-saved; muted: true; font-size: Type.body-small; wrap: word-wrap; }
                HRow {
                    alignment: end; height: 40px; spacing: 8px;
                    Button { text: Tr.cancel; clicked => { root.cred-cancel(); } }
                    Button {
                        text: Tr.sign-in; primary: true; enabled: root.cred-pass != "" && (!root.cred-ask-user || root.cred-user != "");
                        clicked => { root.cred-submit(root.cred-user, root.cred-pass); }
                    }
                }
            }
        }
    }

    if toast != "" : Rectangle {
        width: min(toast-row.preferred-width + 32px, parent.width - 32px); height: 44px;
        x: (parent.width - self.width) / 2; y: parent.height - self.height - 24px;
        border-radius: 14px; background: Palette.inverse-surface;
        toast-row := HRow {
            alignment: center; pad-start: 16px; pad-end: 16px; spacing: 10px;
            if toast-error : Image { source: Icons.warning; colorize: Palette.toast-bad; width: 20px; height: 20px; }
            if !toast-error : Image { source: Icons.check; colorize: Palette.toast-ok; width: 20px; height: 20px; }
            Label { text: root.toast; color: Palette.inverse-on; font-size: Type.body-medium; overflow: elide; }
        }
    }
    // Own title bar: a drag strip, three window buttons and thin resize edges (the Windows frame is off).
    TouchArea {
        x: 0px; y: 0px; width: parent.width - 138px; height: 28px;
        pointer-event(e) => { if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { root.window-drag(); } }
    }
    for glyph[i] in [Icons.minimize, Icons.maximize, Icons.window-close] : Rectangle {
        x: Palette.rtl ? i * 46px : parent.width - (3 - i) * 46px; y: 0px; width: 46px; height: 32px;
        background: wb.has-hover ? (i == 2 ? #e5484d : Palette.on-surface.with-alpha(0.10)) : transparent;
        animate background { duration: 120ms; easing: ease-out; }
        Image { source: glyph; width: 16px; height: 16px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; colorize: wb.has-hover && i == 2 ? white : Palette.on-variant; }
        wb := TouchArea {
            mouse-cursor: pointer;
            clicked => { if i == 0 { root.window-minimize(); } else if i == 1 { root.window-maximize(); } else { root.window-close(); } }
        }
    }
    // resize edges: 1 left 2 right 3 top 4 bottom, 5 top-left 6 top-right 7 bottom-left 8 bottom-right
    for edge[k] in [1, 2, 3, 4, 5, 6, 7, 8] : TouchArea {
        x: edge == 2 || edge == 6 || edge == 8 ? parent.width - 5px : 0px;
        y: edge == 4 || edge == 7 || edge == 8 ? parent.height - 5px : 0px;
        width: edge == 3 || edge == 4 ? parent.width : 5px; height: edge == 1 || edge == 2 ? parent.height : 5px;
        mouse-cursor: edge == 1 || edge == 2 ? MouseCursor.ew-resize : edge == 3 || edge == 4 ? MouseCursor.ns-resize : edge == 5 || edge == 8 ? MouseCursor.nwse-resize : MouseCursor.nesw-resize;
        pointer-event(e) => { if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { root.window-resize(edge); } }
    }

}
