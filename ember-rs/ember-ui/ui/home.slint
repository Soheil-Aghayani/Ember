// The Home page. Port of HomePage in desktop/.../ui/App.kt (orb, status, server picker, notices).
import { Palette, Type, Icons, Motion, Tr } from "theme.slint";
import { Card, Label, HRow, Button } from "widgets.slint";
import { Orb } from "orb.slint";

export struct ServerRow {
    id: string,
    title: string,
    flag: image,
    has-flag: bool,
    detail: string,
    selected: bool,
}

export component HomePage inherits Rectangle {
    in property <int> state;               // 0 disconnected, 1 connecting, 2 connected
    in property <string> status;
    in property <string> secondary;        // elapsed time, or the connection progress
    in property <string> server-title;
    in property <image> server-flag;
    in property <bool> server-has-flag;
    in property <string> server-detail;    // "42 ms" or "18.5 Mbps"
    in property <bool> can-pick;
    in property <bool> auto-selected;
    in property <[ServerRow]> servers;
    in property <string> caption;
    in property <string> error;
    in property <string> blocked-notice;   // the kill switch is holding traffic (or Ember is reconnecting)
    in property <bool> can-restore: true;
    callback restore-internet();
    in property <int> menu-request;        // bump to open the server menu from outside (debug flag --menu)
    callback orb-clicked();
    callback orb-touch(int);
    callback choose(string);
    callback open-servers();

    changed menu-request => { popup.show(); }

    VerticalLayout {
        alignment: start;
        padding-top: 24px;
        spacing: 0px;

        Rectangle {
            height: 260px;
            Orb {
                x: (parent.width - 260px) / 2; width: 260px; height: 260px;
                lit: Motion.lit; angle: Motion.angle; loader: Motion.loader; ripple: Motion.ripple; pop: Motion.pop; feel: Motion.feel;
                ink: Palette.orb-ink; off-sprite: Motion.sphere-off; on-sprite: Motion.sphere-on; sprite-size: Motion.sprite-size;
                clicked => { root.orb-clicked(); }
                touch-state(s) => { root.orb-touch(s); }
            }
            Image {
                source: Icons.power; colorize: #ffffffeb; width: 44px; height: 44px;
                x: (parent.width - self.width) / 2;
            }
        }
        Rectangle { height: 16px; }
        HRow {
            alignment: center; height: 34px; spacing: 8px;
            if state == 2 : Image { source: Icons.check; colorize: Palette.tertiary; width: 28px; height: 28px; }
            Label { text: root.status; font-size: Type.headline-medium; font-weight: 600; }
        }
        if Palette.kitkat : Label {
            text: state == 2 ? Tr.kitkat-connected : (state == 1 ? Tr.kitkat-connecting : Tr.kitkat-disconnected);
            color: Palette.on-variant; font-size: Type.body-small; horizontal-alignment: center; height: 20px;
        }
        if secondary != "" : Rectangle { height: 8px; }
        if secondary != "" : Label { text: root.secondary; muted: true; horizontal-alignment: center; height: 20px; }
        Rectangle { height: 32px; }

        card-area := Rectangle {
            height: card.height;
            card := Card {
                height: 58px;
                HRow {
                    alignment: stretch; pad-start: 16px; pad-end: 16px; padding-top: 16px; padding-bottom: 16px; spacing: 12px;
                    if server-has-flag : Image { source: server-flag; width: 24px; height: 24px; image-fit: contain; }
                    if !server-has-flag : Image { source: auto-selected ? Icons.bolt : Icons.subscriptions; colorize: Palette.on-variant; width: 24px; height: 24px; }
                    Label { text: root.server-title; font-size: Type.body-large; overflow: elide; horizontal-stretch: 1; }
                    if !(state == 2) && server-detail != "" : Label { text: root.server-detail; muted: true; font-size: Type.body-small; }
                    if can-pick : Image { source: Icons.chevron-down; colorize: Palette.on-variant; width: 16px; height: 16px; }
                }
                Rectangle { background: card-touch.has-hover && can-pick ? Palette.on-surface.with-alpha(0.05) : transparent; }
                card-touch := TouchArea {
                    enabled: can-pick; mouse-cursor: can-pick ? pointer : default;
                    clicked => { if root.servers.length == 0 { root.open-servers(); } else { popup.show(); } }
                }
            }
            popup := PopupWindow {
                x: 0px; y: card.height + 6px; width: card-area.width; height: min(root.servers.length * 44px + 2 * 44px + 2px, 300px);
                close-policy: close-on-click-outside;
                Rectangle { background: Palette.dark ? #24201c : #ffffff; border-radius: 16px; border-width: 1px; border-color: Palette.outline-variant; clip: true; }
                VerticalLayout {
                    padding: 4px;
                    Rectangle {
                        height: 44px; border-radius: 10px;
                        background: t0.has-hover ? Palette.primary.with-alpha(0.09) : transparent;
                        animate background { duration: 120ms; easing: ease-out; }
                        HRow { alignment: stretch; pad-start: 12px; pad-end: 12px; spacing: 12px;
                            Image { source: Icons.bolt; colorize: Palette.primary; width: 24px; height: 24px; }
                            Label { text: Tr.fastest-server; horizontal-stretch: 1; }
                            if auto-selected : Image { source: Icons.check; colorize: Palette.primary; width: 20px; height: 20px; }
                        }
                        t0 := TouchArea { mouse-cursor: pointer; clicked => { root.choose("auto"); popup.close(); } }
                    }
                    for row in root.servers : Rectangle {
                        height: 44px; border-radius: 10px;
                        background: tr.has-hover ? Palette.primary.with-alpha(0.09) : transparent;
                        animate background { duration: 120ms; easing: ease-out; }
                        HRow { alignment: stretch; pad-start: 12px; pad-end: 12px; spacing: 12px;
                            if row.has-flag : Image { source: row.flag; width: 24px; height: 24px; image-fit: contain; }
                            if !row.has-flag : Image { source: Icons.subscriptions; colorize: Palette.on-variant; width: 24px; height: 24px; }
                            Label { text: row.title; overflow: elide; horizontal-stretch: 1; }
                            Label { text: row.detail; muted: true; font-size: Type.body-small; }
                            if row.selected && !auto-selected : Image { source: Icons.check; colorize: Palette.primary; width: 20px; height: 20px; }
                        }
                        tr := TouchArea { mouse-cursor: pointer; clicked => { root.choose(row.id); popup.close(); } }
                    }
                    Rectangle {
                        height: 44px; border-radius: 10px;
                        background: tm.has-hover ? Palette.primary.with-alpha(0.09) : transparent;
                        animate background { duration: 120ms; easing: ease-out; }
                        Label { x: 12px; width: parent.width - 24px; text: Tr.manage-servers; }
                        tm := TouchArea { mouse-cursor: pointer; clicked => { popup.close(); root.open-servers(); } }
                    }
                }
            }
        }
        if caption != "" : Rectangle { height: 12px; }
        if caption != "" : Label { text: root.caption; muted: true; font-size: Type.body-small; horizontal-alignment: center; wrap: word-wrap; }
        if error != "" : Rectangle { height: 16px; }
        if error != "" : Label {
            text: root.error; muted: true; font-size: Type.body-small;
            width: parent.width; height: self.preferred-height;
            wrap: word-wrap; horizontal-alignment: center; vertical-alignment: top;
        }
        if blocked-notice != "" : Rectangle { height: 16px; }
        if blocked-notice != "" : Card {
            height: nb-title.preferred-height + nb-body.preferred-height + (can-restore ? 48px : 0px) + 40px;
            nb-title := Label { x: 16px; y: 16px; width: parent.width - 32px; text: Tr.internet-blocked; font-weight: 600; wrap: word-wrap; }
            nb-body := Label {
                x: 16px; y: 24px + nb-title.preferred-height; width: parent.width - 32px;
                text: root.blocked-notice; muted: true; font-size: Type.body-small; wrap: word-wrap;
            }
            if can-restore : Button {
                x: Palette.rtl ? parent.width - self.width - 16px : 16px; y: 32px + nb-title.preferred-height + nb-body.preferred-height;
                text: Tr.restore-internet; primary: true; clicked => { root.restore-internet(); }
            }
        }
    }

}
