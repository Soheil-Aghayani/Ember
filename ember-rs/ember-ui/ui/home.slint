// The Home page. Port of HomePage in desktop/.../ui/App.kt (orb, status, server picker, notices).
import { Palette, Type, Icons, Motion } from "theme.slint";
import { Card, Label, IconAction } from "widgets.slint";
import { Orb } from "orb.slint";

export struct ServerRow {
    id: string,
    title: string,
    flag: image,
    has-flag: bool,
    detail: string,
    selected: bool,
}

export component HomePage inherits Rectangle {
    in property <int> state;               // 0 disconnected, 1 connecting, 2 connected
    in property <string> status;
    in property <string> secondary;        // elapsed time, or the connection progress
    in property <string> server-title;
    in property <image> server-flag;
    in property <bool> server-has-flag;
    in property <string> server-detail;    // "42 ms" or "18.5 Mbps"
    in property <bool> can-pick;
    in property <bool> auto-selected;
    in property <[ServerRow]> servers;
    in property <string> caption;
    in property <string> error;
    in property <string> test-label;
    in property <string> fastest-label;
    in property <string> manage-label;
    callback orb-clicked();
    callback choose(string);
    callback open-servers();
    callback test-speed();

    VerticalLayout {
        alignment: start;
        padding-top: 24px;
        spacing: 0px;

        Rectangle {
            height: 260px;
            Orb {
                x: (parent.width - 260px) / 2; width: 260px; height: 260px;
                lit: Motion.lit; angle: Motion.angle; loader: Motion.loader; ripple: Motion.ripple; pop: Motion.pop;
                ink: Palette.orb-ink; off-sprite: Motion.sphere-off; on-sprite: Motion.sphere-on;
                clicked => { root.orb-clicked(); }
            }
            Image {
                source: Icons.power; colorize: #ffffffeb; width: 44px; height: 44px;
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            }
        }
        Rectangle { height: 16px; }
        HorizontalLayout {
            alignment: center; height: 34px; spacing: 8px;
            if state == 2 : Image { source: Icons.check; colorize: Palette.tertiary; width: 28px; height: 28px; y: 3px; }
            Label { text: root.status; font-size: Type.headline-medium; font-weight: 600; }
        }
        if secondary != "" : Rectangle { height: 8px; }
        if secondary != "" : Label { text: root.secondary; muted: true; horizontal-alignment: center; height: 20px; }
        Rectangle { height: 32px; }

        card-area := Rectangle {
            height: card.height;
            card := Card {
                height: 58px;
                HorizontalLayout {
                    padding: 16px; spacing: 12px;
                    if server-has-flag : Image { source: server-flag; width: 24px; height: 24px; y: (parent.height - self.height) / 2; image-fit: contain; }
                    if !server-has-flag : Image { source: auto-selected ? Icons.bolt : Icons.subscriptions; colorize: Palette.on-variant; width: 24px; height: 24px; y: (parent.height - self.height) / 2; }
                    Label { text: root.server-title; font-size: Type.body-large; overflow: elide; horizontal-stretch: 1; }
                    if !(state == 2) && server-detail != "" : Label { text: root.server-detail; muted: true; font-size: Type.body-small; }
                    if can-pick : Image { source: Icons.chevron-down; colorize: Palette.on-variant; width: 16px; height: 16px; y: (parent.height - self.height) / 2; }
                }
                Rectangle { background: card-touch.has-hover && can-pick ? Palette.on-surface.with-alpha(0.05) : transparent; }
                card-touch := TouchArea {
                    enabled: can-pick; mouse-cursor: can-pick ? pointer : default;
                    clicked => { if root.servers.length == 0 { root.open-servers(); } else { popup.show(); } }
                }
            }
            popup := PopupWindow {
                x: 0px; y: card.height + 6px; width: card-area.width; height: min(root.servers.length * 44px + 2 * 44px + 2px, 300px);
                close-policy: close-on-click-outside;
                Rectangle { background: Palette.dark ? #24201c : #ffffff; border-radius: 16px; border-width: 1px; border-color: Palette.outline-variant; clip: true; }
                VerticalLayout {
                    padding: 4px;
                    Rectangle {
                        height: 44px; border-radius: 10px;
                        background: t0.has-hover ? Palette.primary.with-alpha(0.09) : transparent;
                        HorizontalLayout { padding-left: 12px; padding-right: 12px; spacing: 12px;
                            Image { source: Icons.bolt; colorize: Palette.primary; width: 24px; height: 24px; y: (parent.height - self.height) / 2; }
                            Label { text: root.fastest-label; horizontal-stretch: 1; }
                            if auto-selected : Image { source: Icons.check; colorize: Palette.primary; width: 20px; height: 20px; y: (parent.height - self.height) / 2; }
                        }
                        t0 := TouchArea { mouse-cursor: pointer; clicked => { root.choose("auto"); popup.close(); } }
                    }
                    for row in root.servers : Rectangle {
                        height: 44px; border-radius: 10px;
                        background: tr.has-hover ? Palette.primary.with-alpha(0.09) : transparent;
                        HorizontalLayout { padding-left: 12px; padding-right: 12px; spacing: 12px;
                            if row.has-flag : Image { source: row.flag; width: 24px; height: 24px; y: (parent.height - self.height) / 2; image-fit: contain; }
                            if !row.has-flag : Image { source: Icons.subscriptions; colorize: Palette.on-variant; width: 24px; height: 24px; y: (parent.height - self.height) / 2; }
                            Label { text: row.title; overflow: elide; horizontal-stretch: 1; }
                            Label { text: row.detail; muted: true; font-size: Type.body-small; }
                            if row.selected && !auto-selected : Image { source: Icons.check; colorize: Palette.primary; width: 20px; height: 20px; y: (parent.height - self.height) / 2; }
                        }
                        tr := TouchArea { mouse-cursor: pointer; clicked => { root.choose(row.id); popup.close(); } }
                    }
                    Rectangle {
                        height: 44px; border-radius: 10px;
                        background: tm.has-hover ? Palette.primary.with-alpha(0.09) : transparent;
                        Label { x: 12px; text: root.manage-label; }
                        tm := TouchArea { mouse-cursor: pointer; clicked => { popup.close(); root.open-servers(); } }
                    }
                }
            }
        }
        if can-pick && servers.length > 0 : Rectangle { height: 8px; }
        if can-pick && servers.length > 0 : HorizontalLayout {
            alignment: start; height: 36px;
            IconAction { icon: Icons.bolt; caption: root.test-label; clicked => { root.test-speed(); } }
        }
        if caption != "" : Rectangle { height: 12px; }
        if caption != "" : Label { text: root.caption; muted: true; font-size: Type.body-small; horizontal-alignment: center; wrap: word-wrap; }
        if error != "" : Rectangle { height: 16px; }
        if error != "" : Label { text: root.error; muted: true; font-size: Type.body-small; overflow: elide; }
    }

}
