// The Servers page. Port of SubscriptionsPage.kt: subscription cards with their servers, favourites, usage, and the
// add / edit dialog, file import, WARP, QR codes and the "which servers reach a website" check.
import { Palette, Type, Icons, Tr } from "theme.slint";
import { Card, Label, IconAction, HRow, Button, TextField } from "widgets.slint";

export struct NodeRow {
    id: string,
    title: string,
    protocol: string,
    flag: image,
    has-flag: bool,
    speed: string,
    ping: string,
    has-result: bool,
    no-answer: bool,
    has-bar: bool,
    bar: float,
    starred: bool,
    selected: bool,
    has-qr: bool,
    site: int,   // while a website check shows: 0 none, 1 reached, 2 refused or no answer
}

export struct SitePreset { name: string, address: string }

export struct SubRow {
    id: string,
    name: string,
    url: string,
    status: string,
    has-usage: bool,
    usage-fraction: float,
    usage-text: string,
    info: string,
    can-refresh: bool,
    refreshing: bool,
    expanded: bool,
    nodes: [NodeRow],
}

component ServerLine inherits Rectangle {
    in property <NodeRow> entry;
    in property <bool> first;
    callback select();
    callback favorite();
    callback qr();
    height: 62px;
    background: entry.selected ? Palette.primary.with-alpha(0.16) : (touch.has-hover ? Palette.primary.with-alpha(0.08) : transparent);
    if !first : Rectangle { y: 0; height: 1px; x: 16px; width: parent.width - 32px; background: Palette.outline-variant; }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.select(); } }
    HRow {
        alignment: stretch; pad-start: 16px; pad-end: 8px; spacing: 12px;
        if entry.has-flag : Image { source: entry.flag; width: 24px; height: 24px; image-fit: contain; }
        VerticalLayout {
            // lines at fixed heights, so the numbers on the right sit level with the name and the protocol
            horizontal-stretch: 1; spacing: 2px; padding-top: 10px; alignment: start;
            Label { height: 22px; text: entry.title; font-size: Type.body-large; overflow: elide; }
            Label { height: 16px; text: entry.protocol; muted: true; font-size: 12px; font-weight: 500; }
            if entry.has-bar : Rectangle {
                height: 3px;
                Rectangle { width: parent.width - 12px; height: 3px; border-radius: 2px; background: Palette.outline-variant.with-alpha(0.5); }
                Rectangle {
                    x: Palette.rtl ? parent.width - 12px - self.width : 0px;
                    width: (parent.width - 12px) * entry.bar; height: 3px; border-radius: 2px; background: Palette.primary.with-alpha(0.6);
                }
            }
        }
        Rectangle {
            width: 120px; height: 62px; horizontal-stretch: 0;
            if entry.has-result : Label {
                x: 0px; width: parent.width; y: 10px; height: 22px;
                text: entry.no-answer ? Tr.no-answer : (entry.speed != "" ? entry.speed : entry.ping); font-size: Type.body-medium;
                color: entry.no-answer || entry.site == 2 ? Palette.error : (entry.site == 1 ? Palette.tertiary : Palette.on-surface); horizontal-alignment: Palette.rtl ? left : right;
            }
            if entry.has-result && entry.speed != "" && entry.ping != "" : Label {
                x: 0px; width: parent.width; y: 34px; height: 16px;
                text: entry.ping; muted: true; font-size: 12px; horizontal-alignment: Palette.rtl ? left : right;
            }
        }
        Rectangle {
            width: 36px; height: 62px; horizontal-stretch: 0;   // explicit height: a flex row under-measures, and clicks outside the parent are lost
            if entry.has-qr && entry.selected : IconAction {
                x: 0px; y: (parent.height - self.height) / 2; icon: Icons.qr; tint: Palette.on-variant; clicked => { root.qr(); }
            }
        }
        IconAction {
            icon: entry.starred ? Icons.star-filled : Icons.star;
            tint: entry.starred ? Palette.primary : Palette.on-variant;
            clicked => { root.favorite(); }
        }
        Rectangle {
            width: 20px; horizontal-stretch: 0;
            if entry.selected : Image { source: Icons.check; colorize: Palette.primary; width: 20px; height: 20px; }
        }
    }
}

component SubscriptionCard inherits Card {
    in property <SubRow> sub;
    in property <bool> testing;
    in property <bool> can-test;
    callback toggle();
    callback qr(string);
    callback select(string);
    callback favorite(string);
    callback ping();
    callback test();
    callback stop-test();
    callback refresh();
    callback edit();
    callback remove();
    height: inner.preferred-height;
    inner := VerticalLayout {
        padding-top: 8px; padding-bottom: 8px;
        Rectangle {
            height: 56px;
            TouchArea { mouse-cursor: pointer; clicked => { root.toggle(); } }
            // explicit positions: the name and status on the left, the four actions and the chevron on the right, all centred on the 56 px row
            acts := Rectangle {
                x: Palette.rtl ? 12px : parent.width - self.width - 12px; y: 10px; width: 218px; height: 36px;
                // left to right: delay only, delay and speed (or stop), refresh, edit, delete, chevron (mirrored in a right-to-left language)
                IconAction {
                    x: Palette.rtl ? 182px : 0px; y: 0px;
                    icon: Icons.ping; enabled: !testing && can-test;
                    clicked => { root.ping(); }
                }
                IconAction {
                    x: Palette.rtl ? 142px : 40px; y: 0px;
                    icon: testing ? Icons.stop : Icons.bolt;
                    enabled: testing || can-test;
                    clicked => { if root.testing { root.stop-test(); } else { root.test(); } }
                }
                IconAction { x: Palette.rtl ? 102px : 80px; y: 0px; icon: Icons.refresh; enabled: sub.can-refresh && !sub.refreshing; tint: Palette.on-surface; clicked => { root.refresh(); } }
                IconAction { x: Palette.rtl ? 62px : 120px; y: 0px; icon: Icons.edit; tint: Palette.on-surface; clicked => { root.edit(); } }
                IconAction { x: Palette.rtl ? 22px : 160px; y: 0px; icon: Icons.trash; tint: Palette.on-surface; clicked => { root.remove(); } }
                Image {
                    x: Palette.rtl ? 0px : 200px; y: 9px; width: 18px; height: 18px;
                    source: sub.expanded ? Icons.chevron-up : Icons.chevron-down; colorize: Palette.on-variant;
                }
            }
            Label {
                x: Palette.rtl ? acts.x + acts.width + 8px : 16px; y: 7px; height: 24px; width: parent.width - acts.width - 12px - 16px - 8px;
                text: sub.name; font-size: 17px; font-weight: 600; overflow: elide;
            }
            Label {
                x: Palette.rtl ? acts.x + acts.width + 8px : 16px; y: 31px; height: 18px; width: parent.width - acts.width - 12px - 16px - 8px;
                text: sub.status; muted: true; font-size: Type.body-small; overflow: elide;
            }
        }
        if sub.has-usage : VerticalLayout {
            padding-left: 16px; padding-right: 16px; spacing: 4px;
            Rectangle {
                height: 4px;
                Rectangle { height: 4px; border-radius: 2px; background: Palette.surface-variant; }
                Rectangle {
                    x: Palette.rtl ? parent.width - self.width : 0px;
                    width: parent.width * sub.usage-fraction; height: 4px; border-radius: 2px; background: Palette.primary;
                }
            }
            Label { text: sub.usage-text; muted: true; font-size: Type.body-small; }
        }
        if sub.expanded && sub.info != "" : VerticalLayout {
            padding-left: 16px; padding-right: 16px;
            Label { text: sub.info; muted: true; font-size: Type.body-small; wrap: word-wrap; }
        }
        if !testing && !can-test : Label { text: Tr.test-needs-disconnect; muted: true; font-size: Type.body-small; }
        if sub.expanded : Rectangle { height: 8px; }
        if sub.expanded : Rectangle { height: 1px; background: Palette.outline-variant; }
        if sub.expanded : VerticalLayout {
            for node[i] in sub.nodes : ServerLine {
                entry: node; first: i == 0;
                select => { root.select(node.id); }
                favorite => { root.favorite(node.id); }
                qr => { root.qr(node.id); }
            }
        }
    }
}

export component ServersPage inherits Rectangle {
    in property <[SubRow]> subs;
    in property <bool> testing;
    in property <bool> can-test: true;
    in property <string> test-progress;
    in property <string> notice;
    in property <bool> notice-error;
    in property <bool> dialog-busy;
    in property <string> dialog-error;
    in property <int> dialog-done;
    in property <int> dialog-request;   // bump to open the add dialog from outside (debug flag --dialog)
    in property <string> pasted-text;
    in property <int> paste-serial;     // bumped when pasted-text holds new clipboard text
    callback paste-request();
    in property <[SitePreset]> site-presets;
    in property <string> site-label;     // the website a check is showing, or ""
    in property <string> qr-title;
    in property <string> qr-link;
    in property <image> qr-image;
    in property <bool> qr-has-image;
    in-out property <bool> qr-open: false;
    callback import-files();
    callback add-warp();
    callback show-qr(string);
    callback copy-link(string);
    callback check-site(string);   // what was typed or picked
    callback clear-site-check();
    callback toggle-expanded(string);
    callback select(string);
    callback favorite(string);
    callback ping(string);
    callback test(string);
    callback stop-test();
    callback refresh(string);
    callback remove(string);
    callback submit(string, string, string);   // id ("" for a new one), link, name

    property <bool> dialog-open: false;
    property <string> dialog-id: "";
    property <string> dialog-title: "";
    property <string> dialog-link: "";
    property <string> dialog-name: "";
    property <bool> site-open: false;
    property <string> site-input: "";

    changed dialog-done => { dialog-open = false; }
    changed paste-serial => { dialog-link = dialog-link == "" ? pasted-text : dialog-link + "\n" + pasted-text; }
    changed dialog-request => { dialog-id = ""; dialog-title = Tr.add-link; dialog-link = ""; dialog-name = ""; dialog-open = true; }

    Flickable {
        content-height: page.preferred-height + 48px;
        page := VerticalLayout {
            y: 0px; padding-top: 0px; padding-bottom: 16px; spacing: 0px; alignment: start;
            Rectangle {
                height: 44px;
                // title and the four icon buttons share one centre line (a flex row left them 10 px apart)
                add-button := IconAction {
                    x: Palette.rtl ? 0px : parent.width - self.width; y: 4px;
                    icon: Icons.plus; filled: true;   // icon only; the empty page below still says "Add servers" in words
                    clicked => { root.dialog-id = ""; root.dialog-title = Tr.add-link; root.dialog-link = ""; root.dialog-name = ""; root.dialog-open = true; }
                }
                IconAction { x: Palette.rtl ? 40px : parent.width - 80px; y: 4px; icon: Icons.cloud; tint: Palette.on-surface; clicked => { root.add-warp(); } }
                IconAction { x: Palette.rtl ? 80px : parent.width - 120px; y: 4px; icon: Icons.import-file; tint: Palette.on-surface; clicked => { root.import-files(); } }
                IconAction {
                    x: Palette.rtl ? 120px : parent.width - 160px; y: 4px; icon: Icons.magnifier; tint: Palette.on-surface;
                    enabled: root.can-test && !root.testing && root.subs.length > 0;
                    clicked => { root.site-input = ""; root.site-open = true; }
                }
                Label {
                    x: Palette.rtl ? 172px : 0px; y: 0px; height: 44px;
                    width: parent.width - 172px;
                    text: Tr.subscriptions; font-size: Type.headline-medium; font-weight: 600;
                }
            }
            Rectangle { height: 12px; }
            Label { text: Tr.subscriptions-help; muted: true; font-size: Type.body-small; wrap: word-wrap; }
            if notice != "" : Rectangle { height: 12px; }
            if notice != "" : Label {
                text: root.notice; font-size: Type.body-small; wrap: word-wrap;
                color: root.notice-error ? Palette.error : Palette.tertiary;
            }
            if site-label != "" : Rectangle { height: 12px; }
            if site-label != "" : Rectangle {
                height: 40px; border-radius: 12px; background: Palette.primary.with-alpha(0.10);
                Image {
                    source: Icons.magnifier; colorize: Palette.primary; width: 18px; height: 18px;
                    x: Palette.rtl ? parent.width - self.width - 14px : 14px; y: (parent.height - self.height) / 2;
                }
                Label {
                    x: 44px; width: parent.width - 88px; height: parent.height;
                    text: root.site-label; font-size: Type.body-medium; font-weight: 600; overflow: elide;
                    horizontal-alignment: Palette.rtl ? right : left;
                }
                IconAction {
                    x: Palette.rtl ? 2px : parent.width - self.width - 2px; y: 2px; icon: Icons.close; tint: Palette.on-surface;
                    clicked => { root.clear-site-check(); }
                }
            }
            Rectangle { height: 16px; }
            if subs.length == 0 : Card {
                height: 250px;
                VerticalLayout {
                    alignment: center; spacing: 12px; padding: 24px;
                    HRow { alignment: center; height: 48px; Image { source: Icons.subscriptions; colorize: Palette.on-variant; width: 48px; height: 48px; } }
                    Label { text: Tr.empty-title; font-size: Type.body-large; font-weight: 600; horizontal-alignment: center; }
                    Label { text: Tr.empty-text; muted: true; font-size: Type.body-small; wrap: word-wrap; horizontal-alignment: center; }
                    HRow {
                        alignment: center; height: 40px;
                        Button {
                            text: Tr.add-link; primary: true;
                            clicked => { root.dialog-id = ""; root.dialog-title = Tr.add-link; root.dialog-link = ""; root.dialog-name = ""; root.dialog-open = true; }
                        }
                    }
                }
            }
            for sub in subs : VerticalLayout {
                padding-bottom: 16px;
                SubscriptionCard {
                    sub: sub; testing: root.testing; can-test: root.can-test && !root.testing;
                    toggle => { root.toggle-expanded(sub.id); }
                    select(id) => { root.select(id); }
                    favorite(id) => { root.favorite(id); }
                    qr(id) => { root.show-qr(id); }
                    ping => { root.ping(sub.id); }
                    test => { root.test(sub.id); }
                    stop-test => { root.stop-test(); }
                    refresh => { root.refresh(sub.id); }
                    remove => { root.remove(sub.id); }
                    edit => { root.dialog-id = sub.id; root.dialog-title = Tr.edit; root.dialog-link = sub.url; root.dialog-name = sub.name; root.dialog-open = true; }
                }
            }
        }
    }

    if dialog-open : Rectangle {
        // the page is inset from the window edges, so the dimming is far larger than the page (the window clips it)
        Rectangle {
            x: -2000px; y: -2000px; width: 4000px; height: 4000px; background: #00000088;
            TouchArea { }   // blocks the page behind the dialog
        }
        Rectangle {
            width: min(480px, parent.width - 32px); height: dlg.preferred-height + 48px;
            x: (parent.width - self.width) / 2; y: max(24px, (parent.height - self.height) / 3);
            border-radius: 16px; border-width: 1px; border-color: Palette.glass-edge;
            background: Palette.dark ? #24201c : #ffffff;
            dlg := VerticalLayout {
                padding: 24px; spacing: 12px;
                Label { text: root.dialog-title; font-size: Type.headline-small; font-weight: 600; }
                Label { text: Tr.link-label; muted: true; font-size: Type.body-small; }
                TextField { multiline: true; placeholder: "https://..."; text <=> root.dialog-link; }
                HRow {
                    alignment: start; height: 36px;
                    IconAction { icon: Icons.clipboard; caption: Tr.paste-clipboard; clicked => { root.paste-request(); } }
                }
                Label { text: Tr.name-label; muted: true; font-size: Type.body-small; }
                TextField { text <=> root.dialog-name; }
                if dialog-error != "" : Label { text: root.dialog-error; color: Palette.error; font-size: Type.body-small; wrap: word-wrap; }
                HRow {
                    alignment: end; height: 40px; spacing: 8px;
                    Button { text: Tr.cancel; enabled: !root.dialog-busy; clicked => { root.dialog-open = false; } }
                    Button {
                        text: root.dialog-busy ? (root.dialog-id == "" ? Tr.adding : Tr.saving) : (root.dialog-id == "" ? Tr.add-link : Tr.save);
                        primary: true; enabled: !root.dialog-busy && root.dialog-link != "";
                        clicked => { root.submit(root.dialog-id, root.dialog-link, root.dialog-name); }
                    }
                }
            }
        }
    }

    if site-open : Rectangle {
        Rectangle {
            x: -2000px; y: -2000px; width: 4000px; height: 4000px; background: #00000088;
            TouchArea { }
        }
        Rectangle {
            width: min(480px, parent.width - 32px); height: sdlg.preferred-height + 48px;
            x: (parent.width - self.width) / 2; y: max(24px, (parent.height - self.height) / 3);
            border-radius: 16px; border-width: 1px; border-color: Palette.glass-edge;
            background: Palette.dark ? #24201c : #ffffff;
            sdlg := VerticalLayout {
                padding: 24px; spacing: 12px;
                Label { text: Tr.check-site-title; font-size: Type.headline-small; font-weight: 600; }
                Label { text: Tr.check-site-help; muted: true; font-size: Type.body-small; wrap: word-wrap; vertical-alignment: top; }
                HRow {
                    alignment: start; height: 36px; spacing: 8px;
                    for preset in root.site-presets : Rectangle {
                        height: 32px; width: chip.preferred-width + 24px; border-radius: 16px; horizontal-stretch: 0;
                        border-width: 1px; border-color: root.site-input == preset.address ? Palette.primary : Palette.outline-variant;
                        background: root.site-input == preset.address ? Palette.primary.with-alpha(0.14) : (chip-touch.has-hover ? Palette.primary.with-alpha(0.06) : transparent);
                        chip := Label { x: 12px; y: 0px; height: parent.height; text: preset.name; font-size: Type.body-small; font-weight: 500; }
                        chip-touch := TouchArea { mouse-cursor: pointer; clicked => { root.site-input = preset.address; } }
                    }
                }
                TextField { placeholder: Tr.site-hint; text <=> root.site-input; accepted(t) => { if t != "" { root.site-open = false; root.check-site(t); } } }
                HRow {
                    alignment: end; height: 40px; spacing: 8px;
                    Button { text: Tr.cancel; clicked => { root.site-open = false; } }
                    // shown once there is something to check (a dimmed solid button is hard to read)
                    if root.site-input != "" : Button {
                        text: Tr.check-button; primary: true;
                        clicked => { root.site-open = false; root.check-site(root.site-input); }
                    }
                }
            }
        }
    }

    if qr-open : Rectangle {
        Rectangle {
            x: -2000px; y: -2000px; width: 4000px; height: 4000px; background: #00000088;
            TouchArea { clicked => { root.qr-open = false; } }
        }
        Rectangle {
            width: min(340px, parent.width - 32px); height: qdlg.preferred-height + 48px;
            x: (parent.width - self.width) / 2; y: max(24px, (parent.height - self.height) / 4);
            border-radius: 16px; border-width: 1px; border-color: Palette.glass-edge;
            background: Palette.dark ? #24201c : #ffffff;
            qdlg := VerticalLayout {
                padding: 24px; spacing: 12px;
                Label { text: root.qr-title; font-size: Type.body-large; font-weight: 600; overflow: elide; }
                // always on white, so a phone can read it in the dark theme too
                if root.qr-has-image : Rectangle {
                    height: 292px; border-radius: 12px; background: white;
                    Image {
                        source: root.qr-image; image-rendering: pixelated;
                        x: 6px; y: 6px; width: parent.width - 12px; height: parent.height - 12px; image-fit: contain;
                    }
                }
                Label { text: root.qr-has-image ? Tr.qr-hint : Tr.qr-too-long; muted: true; font-size: Type.body-small; wrap: word-wrap; horizontal-alignment: center; }
                Rectangle {
                    height: 40px;
                    IconAction { x: Palette.rtl ? parent.width - self.width : 0px; y: 2px; icon: Icons.copy; tint: Palette.primary; clicked => { root.copy-link(root.qr-link); } }
                    Button { x: Palette.rtl ? 0px : parent.width - self.width; y: 0px; text: Tr.close; clicked => { root.qr-open = false; } }
                }
            }
        }
    }
}
