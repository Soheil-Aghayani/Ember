{
  "cases": [
    {
      "name": "vless reality",
      "link": "vless://11111111-2222-3333-4444-555555555555@vl.example.com:443?type=tcp&security=reality&pbk=KEY&sni=www.example.org&sid=ab&flow=xtls-rprx-vision#UK%20Reality",
      "address": "203.0.113.7",
      "tag": "proxy",
      "expected": {
        "tag": "proxy",
        "protocol": "vless",
        "settings": {
          "vnext": [
            {
              "address": "203.0.113.7",
              "port": 443,
              "users": [
                {
                  "id": "11111111-2222-3333-4444-555555555555",
                  "encryption": "none",
                  "flow": "xtls-rprx-vision"
                }
              ]
            }
          ]
        },
        "streamSettings": {
          "network": "tcp",
          "security": "reality",
          "realitySettings": {
            "serverName": "www.example.org",
            "fingerprint": "chrome",
            "publicKey": "KEY",
            "shortId": "ab",
            "spiderX": ""
          }
        }
      }
    },
    {
