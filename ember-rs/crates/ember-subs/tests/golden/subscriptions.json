    {
      "name": "xray json: first real outbound of each config, remarks fall back",
      "body": "[{\"remarks\": \"One\", \"outbounds\": [{\"protocol\": \"freedom\", \"tag\": \"direct\"}, {\"protocol\": \"vless\", \"settings\": {\"vnext\": [{\"address\": \"j1.example.com\", \"port\": 443, \"users\": [{\"id\": \"11111111-2222-3333-4444-555555555555\"}]}]}}]}, {\"ps\": \"Two\", \"outbounds\": [{\"protocol\": \"shadowsocks\", \"settings\": {\"servers\": [{\"address\": \"j2.example.com\", \"port\": 8388, \"method\": \"m\", \"password\": \"p\"}]}}]}, {\"outbounds\": [{\"protocol\": \"wireguard\", \"settings\": {\"peers\": [{\"endpoint\": \"[2001:db8::1]:51820\"}]}}]}, {\"outbounds\": [{\"protocol\": \"freedom\"}]}, \"not an object\"]",
      "expected": [
