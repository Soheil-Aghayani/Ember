import { Orb } from "orb.slint";

export component App inherits Window {
    in property <float> angle;
    in property <float> lit;
    in property <float> loader;
    in property <float> ripple: 1;
    in property <float> pop: 1;
    in property <string> label: "Connect";
    callback toggle();
    width: 420px; height: 360px;
    title: "Ember prototype";
    background: #14161c;

    Orb {
        x: 60px; y: 10px; width: 300px; height: 300px;
        lit: root.lit; angle: root.angle; loader: root.loader; ripple: root.ripple; pop: root.pop;
        clicked => { root.toggle(); }
    }
    Text { x: 0; y: 315px; width: root.width; horizontal-alignment: center; text: label; color: #e8eaf0; font-size: 18px; }
}
