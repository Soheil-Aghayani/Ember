<?xml version="1.0" encoding="utf-8"?>
<!-- Wide, short widget: keep the connection details together and the toggle easy to reach. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:outlineProvider="background">

    <ImageView
        android:id="@+id/widget_orb"
        android:layout_width="150dp"
        android:layout_height="match_parent"
        android:layout_gravity="end|center_vertical"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitEnd"
        android:src="@drawable/widget_orb" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="64dp">

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_server"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFB8B8BE"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_power"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="12dp"
        android:background="@drawable/widget_power_bg"
        android:contentDescription="@null"
        android:padding="8dp"
        android:src="@drawable/ic_solar_power"
        android:tint="#FFFFFFFF" />
</FrameLayout>
