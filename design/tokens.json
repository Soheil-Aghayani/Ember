{
  "$comment": "Ember design tokens. Source of truth for android/ and desktop/. Colors verified WCAG AA (text >= 4.5:1).",
  "color": {
    "light": {
      "background":        "#FAF7F2",
      "surface":           "#FFFFFF",
      "surfaceSunken":     "#F1ECE3",
      "separator":         "#E4DDD1",
      "textPrimary":       "#1F1B16",
      "textSecondary":     "#6B645B",
      "accent":            "#C4400A",
      "onAccent":          "#FFFFFF",
      "accentText":        "#B63A06",
      "accentSoft":        "#FBE6DA",
      "secondary":         "#6A3BD1",
      "secondarySoft":     "#ECE5FA",
      "connected":         "#1E7A3C",
      "connecting":        "#8A5A00",
      "error":             "#BA1A1A"
    },
    "dark": {
      "background":        "#1A1714",
      "surface":           "#24201C",
      "surfaceSunken":     "#14110F",
      "separator":         "#3A342D",
      "textPrimary":       "#F3EEE6",
      "textSecondary":     "#A39B90",
      "accent":            "#FF7139",
      "onAccent":          "#1A1714",
      "accentText":        "#FF8A55",
      "accentSoft":        "#3A2218",
      "secondary":         "#B79CFF",
      "secondarySoft":     "#2C2540",
      "connected":         "#5FD17F",
      "connecting":        "#FFC46B",
      "error":             "#FFB4AB"
    }
  },
  "font": {
    "family": "Inter",
    "fallback": ["system-ui", "Roboto", "Segoe UI", "sans-serif"],
    "mono": "JetBrains Mono"
  },
  "type": {
    "$comment": "Mirrors Apple HIG text styles. size/lineHeight in sp (Android) or px (desktop).",
    "largeTitle": { "size": 34, "lineHeight": 41, "weight": 700 },
    "title1":     { "size": 28, "lineHeight": 34, "weight": 700 },
    "title2":     { "size": 22, "lineHeight": 28, "weight": 600 },
    "title3":     { "size": 20, "lineHeight": 25, "weight": 600 },
    "headline":   { "size": 17, "lineHeight": 22, "weight": 600 },
    "body":       { "size": 17, "lineHeight": 22, "weight": 400 },
    "callout":    { "size": 16, "lineHeight": 21, "weight": 400 },
    "subheadline":{ "size": 15, "lineHeight": 20, "weight": 400 },
    "footnote":   { "size": 13, "lineHeight": 18, "weight": 400 },
    "caption":    { "size": 12, "lineHeight": 16, "weight": 400 }
  },
  "space": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32 },
  "radius": { "sm": 8, "md": 12, "lg": 16, "xl": 24, "pill": 999 },
  "size": {
    "minTouchTarget": { "android": 48, "desktop": 32 },
    "iconDefault": 22,
    "listRowMinHeight": 52
  },
  "motion": {
    "fastMs": 150,
    "standardMs": 250,
    "easing": "cubic-bezier(0.2, 0.0, 0.0, 1.0)",
    "respectReducedMotion": true
  },
  "icons": {
    "style": "outline, 1.75px stroke, rounded caps and joins",
    "license": "Do not ship SF Symbols or SF Pro outside Apple platforms. Use Inter and original or GPT-generated icons."
  }
}
